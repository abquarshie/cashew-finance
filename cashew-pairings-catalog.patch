+SOUP_WEEK = {5: {"name": "Kokonte", "portions": 2, "keeps_days": 1, "prep_note": None, "prep_hours": None,
+                 "role": "starch"},
+             6: {"name": "Palm nut soup", "portions": 14, "keeps_days": 7, "prep_note": None, "prep_hours": None,
+                 "role": "soup"}}
+SOUP_ITEMS = {5: [(40, 1.5, "cup")], 6: [(41, 800, "g"), (42, 1, "kg")]}
