+        missing += [n for n in names if n not in missing]
+        states.append((status, names))
+    status = meal_status(states)
+    if status == "done":
+        return "done", "done"
+    if status == "short":
+        return "short", "missing " + ", ".join(missing[:3]) + (f" +{len(missing) - 3}" if len(missing) > 3 else "")
