# Streamlit secrets (.streamlit/secrets.toml locally, or "Secrets" in Streamlit Cloud settings)

DATABASE_URL = "postgresql://user:password@host/dbname"

# Sign-in uses usernames and passwords stored (hashed) in the database.
# The first person to open the app creates the owner account; the owner then
# shares an invite code (Settings → People & sign-in) with the rest of the family.
